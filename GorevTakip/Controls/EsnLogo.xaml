<UserControl x:Class="GorevTakip.Controls.EsnLogo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <!-- altıgenin iki yarısı ters yönde renk geçişi yapıyor, logodaki gibi -->
    <LinearGradientBrush x:Key="LeftHalf" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="{StaticResource EsnCyanColor}" Offset="0"/>
      <GradientStop Color="{StaticResource EsnBlueColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RightHalf" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="{StaticResource EsnBlueColor}" Offset="0"/>
      <GradientStop Color="{StaticResource EsnCyanColor}" Offset="1"/>
    </LinearGradientBrush>
  </UserControl.Resources>

  <StackPanel Orientation="Horizontal">
    <!-- 100x100'lük koordinatta çizip viewbox ile ölçekliyoruz -->
    <Viewbox Width="46" Height="46" VerticalAlignment="Center">
      <Canvas Width="100" Height="100">
        <!-- köşeler yuvarlak olsun diye aynı renkte kalın kenar çizgisi veriyoruz -->
        <Path Data="M50,5 L11,27.5 L11,72.5 L50,95 Z" Fill="{StaticResource LeftHalf}" Stroke="{StaticResource LeftHalf}"
              StrokeThickness="9" StrokeLineJoin="Round"/>
        <Path Data="M50,5 L89,27.5 L89,72.5 L50,95 Z" Fill="{StaticResource RightHalf}" Stroke="{StaticResource RightHalf}"
              StrokeThickness="9" StrokeLineJoin="Round"/>

        <!-- beyaz E bloğu -->
        <Rectangle Canvas.Left="28" Canvas.Top="27" Width="43" Height="46" RadiusX="11" RadiusY="11" Fill="White"/>

        <!-- E'yi oluşturan iki ok şeklindeki oyuk -->
        <Path Stroke="{StaticResource Accent}" StrokeThickness="5.5" StrokeLineJoin="Round"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Data="M73,42 L44,42 M50,36.5 L44,42 L50,47.5 M73,58 L44,58 M50,52.5 L44,58 L50,63.5"/>
      </Canvas>
    </Viewbox>

    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
      <TextBlock FontSize="22" VerticalAlignment="Center">
        <Run Text="ESN" FontWeight="Black" Foreground="{StaticResource EsnBlue}"/><Run Text=" Görev Takip" FontWeight="Normal"
             Foreground="{StaticResource Text}"/>
      </TextBlock>
      <TextBlock x:Name="SubtitleText" Foreground="{StaticResource TextMuted}" FontSize="12.5" Margin="1,1,0,0"/>
    </StackPanel>
  </StackPanel>
</UserControl>
