<Window x:Class="GorevTakip.Views.StagesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aşamalar" Width="540" SizeToContent="Height" ResizeMode="NoResize"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" UseLayoutRounding="True" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Icon="pack://application:,,,/GorevTakip;component/Assets/app.ico">

  <Window.Resources>
    <DataTemplate x:Key="StageTemplate">
      <Grid x:Name="row" Margin="0,0,0,6">
        <Border x:Name="bg" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="1" CornerRadius="8"/>
        <Grid Margin="12,9">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button Style="{StaticResource CheckCircle}" Click="StageToggle_Click" VerticalAlignment="Top"
                  Margin="0,1,12,0" ToolTip="Yapıldı / yapılmadı"/>
          <StackPanel Grid.Column="1">
            <TextBlock x:Name="text" Text="{Binding Text}" TextWrapping="Wrap" FontSize="13.5"/>
            <TextBlock Text="{Binding DateText}" Foreground="{StaticResource TextFaint}" FontSize="11.5" Margin="0,3,0,0"/>
          </StackPanel>
          <!-- sil butonu sadece üstüne gelince görünüyor, liste kalabalık durmasın -->
          <Button x:Name="del" Grid.Column="2" Style="{StaticResource GhostBtn}" Padding="7,5" VerticalAlignment="Top"
                  Click="StageDelete_Click" ToolTip="Aşamayı sil" Opacity="0">
            <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="11"/>
          </Button>
        </Grid>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsDone}" Value="True">
          <Setter TargetName="text" Property="Foreground" Value="{StaticResource TextMuted}"/>
        </DataTrigger>
        <Trigger SourceName="row" Property="IsMouseOver" Value="True">
          <Setter TargetName="del" Property="Opacity" Value="1"/>
          <Setter TargetName="bg" Property="Background" Value="{StaticResource SurfaceHover}"/>
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <StackPanel Margin="22,18,22,20">
    <TextBlock Text="AŞAMALAR" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource EsnBlue}"/>
    <TextBlock x:Name="TaskTitle" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>

    <TextBlock x:Name="SummaryText" Foreground="{StaticResource TextMuted}" FontSize="12.5" Margin="0,14,0,6"/>
    <ProgressBar x:Name="Bar" Style="{StaticResource ThinProgress}" Height="6" Maximum="1"/>

    <ScrollViewer x:Name="Scroller" MaxHeight="330" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="StageList" ItemTemplate="{StaticResource StageTemplate}" Margin="0,0,4,0"/>
    </ScrollViewer>

    <TextBlock x:Name="EmptyText" Foreground="{StaticResource TextFaint}" FontSize="12.5" Margin="0,4,0,4"
               Text="Henüz aşama yok. Aşağıdan ilk adımı ekleyebilirsin."/>

    <Border x:Name="AllDoneBanner" Background="{StaticResource SuccessSoft}" CornerRadius="8" Padding="14,10"
            Margin="0,8,0,0" Visibility="Collapsed">
      <Grid>
        <TextBlock Text="Tüm aşamalar tamamlandı." Foreground="{StaticResource Success}" FontWeight="SemiBold"
                   VerticalAlignment="Center"/>
        <Button HorizontalAlignment="Right" Style="{StaticResource SuccessBtn}" Content="Görevi de tamamla"
                Padding="12,5" Click="CompleteTask_Click"/>
      </Grid>
    </Border>

    <TextBox x:Name="NewStageBox" Margin="0,16,0,0" KeyDown="NewStageBox_KeyDown"
             Tag="Yeni aşama… (ör. Endpointler düzeltildi, portlar check edilecek)"/>

    <Grid Margin="0,10,0,0">
      <TextBlock Foreground="{StaticResource TextFaint}" FontSize="11.5" VerticalAlignment="Center" TextWrapping="Wrap"
                 Text="Enter: sıradaki · Ctrl+Enter: yapıldı" Margin="0,0,200,0"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Click="AddDone_Click" Margin="0,0,8,0" ToolTip="Bitmiş bir adımı kayda geçir">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{StaticResource Success}"
                       VerticalAlignment="Center" Margin="0,1,7,0"/>
            <TextBlock Text="Yapıldı"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource AccentBtn}" Click="AddNext_Click" ToolTip="Sıradaki adım olarak ekle">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center" Margin="0,1,7,0"/>
            <TextBlock Text="Sıradaki"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <Border Height="1" Background="{StaticResource Border}" Margin="0,18,0,14"/>
    <Button Content="Kapat" IsCancel="True" HorizontalAlignment="Right" MinWidth="90"/>
  </StackPanel>
</Window>
