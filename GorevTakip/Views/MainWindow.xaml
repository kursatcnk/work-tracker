<Window x:Class="GorevTakip.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GorevTakip.Controls"
        xmlns:local="clr-namespace:GorevTakip.Views"
        Title="ESN Görev Takip" Width="780" Height="700" MinWidth="560" MinHeight="440"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown"
        Icon="pack://application:,,,/GorevTakip;component/Assets/app.ico">

  <Window.InputBindings>
    <KeyBinding Key="N" Modifiers="Control" Command="New"/>
    <KeyBinding Key="F" Modifiers="Control" Command="Find"/>
    <KeyBinding Key="E" Modifiers="Control" Command="{x:Static local:MainWindow.StagesCommand}"/>
  </Window.InputBindings>
  <Window.CommandBindings>
    <CommandBinding Command="New" Executed="NewCommand_Executed"/>
    <CommandBinding Command="Find" Executed="FindCommand_Executed"/>
    <CommandBinding Command="{x:Static local:MainWindow.StagesCommand}" Executed="StagesCommand_Executed"/>
  </Window.CommandBindings>

  <Window.Resources>

    <!-- kartın sağ tık menüsü. x:Shared=False şart, yoksa tüm kartlar aynı menü nesnesini paylaşıyor -->
    <ContextMenu x:Key="ItemMenu" x:Shared="False">
      <MenuItem Click="MenuToggleComplete_Click">
        <MenuItem.Icon>
          <TextBlock Text="&#xE73E;" Style="{StaticResource MenuIcon}" Foreground="{StaticResource Success}"/>
        </MenuItem.Icon>
        <MenuItem.Style>
          <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Header" Value="Tamamlandı olarak işaretle"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                <Setter Property="Header" Value="Geri al (tekrar aktif yap)"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </MenuItem.Style>
      </MenuItem>
      <MenuItem Header="Düzenle" InputGestureText="Çift tık" Click="MenuEdit_Click">
        <MenuItem.Icon>
          <TextBlock Text="&#xE70F;" Style="{StaticResource MenuIcon}"/>
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Click="MenuStages_Click" InputGestureText="Ctrl+E">
        <MenuItem.Icon>
          <TextBlock Text="&#xE8FD;" Style="{StaticResource MenuIcon}" Foreground="{StaticResource EsnBlue}"/>
        </MenuItem.Icon>
        <MenuItem.Style>
          <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Header" Value="Aşama ekle…"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasStages}" Value="True">
                <Setter Property="Header" Value="Aşamalar / aşama ekle…"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </MenuItem.Style>
      </MenuItem>
      <MenuItem Click="MenuReminder_Click">
        <MenuItem.Icon>
          <TextBlock Text="&#xEA8F;" Style="{StaticResource MenuIcon}" Foreground="{StaticResource Warning}"/>
        </MenuItem.Icon>
        <MenuItem.Style>
          <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Header" Value="Hatırlatıcı kur…"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasReminder}" Value="True">
                <Setter Property="Header" Value="Hatırlatıcıyı değiştir…"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </MenuItem.Style>
      </MenuItem>
      <MenuItem Header="Hatırlatıcıyı kaldır" Click="MenuRemoveReminder_Click">
        <MenuItem.Icon>
          <TextBlock Text="&#xE711;" Style="{StaticResource MenuIcon}"/>
        </MenuItem.Icon>
        <MenuItem.Style>
          <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasReminder}" Value="False">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </MenuItem.Style>
      </MenuItem>
      <MenuItem Header="Metni kopyala" InputGestureText="Ctrl+C" Click="MenuCopy_Click">
        <MenuItem.Icon>
          <TextBlock Text="&#xE8C8;" Style="{StaticResource MenuIcon}"/>
        </MenuItem.Icon>
      </MenuItem>
      <Separator/>
      <MenuItem Header="Sil" InputGestureText="Del" Click="MenuDelete_Click" Foreground="{StaticResource Danger}">
        <MenuItem.Icon>
          <TextBlock Text="&#xE74D;" Style="{StaticResource MenuIcon}" Foreground="{StaticResource Danger}"/>
        </MenuItem.Icon>
      </MenuItem>
    </ContextMenu>

    <!-- görev kartı -->
    <DataTemplate x:Key="ItemTemplate">
      <Grid x:Name="cardRoot" Margin="0,0,0,8">
        <Border x:Name="card" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="1" CornerRadius="10"/>
        <!-- öncelik şeridi, köşesi kartla aynı yuvarlaklıkta olsun diye ayrı border -->
        <Border x:Name="stripe" Width="4" HorizontalAlignment="Left" CornerRadius="10,0,0,10" Background="Transparent"/>
        <Grid Margin="14,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- normalde tamamla yuvarlağı, toplu seçim modunda onun yerine seçim kutusu görünüyor -->
          <Grid VerticalAlignment="Top" Margin="0,1,14,0">
            <Button x:Name="checkBtn" Style="{StaticResource CheckCircle}" Click="Check_Click"
                    ToolTip="Tamamlandı olarak işaretle"/>
            <Border x:Name="selBox" Width="20" Height="20" CornerRadius="5" BorderBrush="#5A5B66" BorderThickness="1.6"
                    Background="Transparent" Visibility="Collapsed">
              <TextBlock x:Name="selMark" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Border>
          </Grid>

          <StackPanel Grid.Column="1">
            <TextBlock x:Name="title" Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold"
                       Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
            <TextBlock x:Name="note" Text="{Binding Note}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                       Margin="0,4,0,0" MaxHeight="58" TextTrimming="CharacterEllipsis" FontSize="13"/>

            <!-- aşama satırı: tıklayınca aşamalar penceresi açılıyor -->
            <StackPanel x:Name="stageRow" Margin="0,9,0,0" Cursor="Hand" Background="Transparent"
                        MouseLeftButtonUp="StageRow_Click" ToolTip="Aşamaları göster / yeni aşama ekle">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border CornerRadius="5" Padding="7,3" Background="{StaticResource Surface2}" Margin="0,0,8,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource Icons}" FontSize="11"
                               Foreground="{StaticResource EsnBlue}" VerticalAlignment="Center" Margin="0,1,6,0"/>
                    <TextBlock Text="{Binding StageProgressText}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource Text}"/>
                  </StackPanel>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding CurrentStageText}" Foreground="{StaticResource TextMuted}"
                           FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </Grid>
              <ProgressBar Style="{StaticResource ThinProgress}" Height="3" Maximum="1" Margin="0,7,0,0"
                           Value="{Binding StageProgress, Mode=OneWay}"/>
            </StackPanel>

            <WrapPanel Margin="0,9,0,0">
              <!-- etiket rozeti: tıklayınca liste bu etikete göre süzülüyor -->
              <Border x:Name="label" CornerRadius="5" Padding="7,3" Margin="0,0,8,0" Cursor="Hand"
                      Background="{Binding Label, Converter={StaticResource LabelBrush}, ConverterParameter=bg}"
                      MouseLeftButtonUp="LabelChip_Click" ToolTip="Bu müşterinin/etiketin görevlerini göster">
                <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{Binding Label, Converter={StaticResource LabelBrush}, ConverterParameter=fg}"/>
              </Border>
              <Border x:Name="prio" CornerRadius="5" Padding="7,3" Margin="0,0,8,0" Visibility="Collapsed">
                <TextBlock x:Name="prioText" Text="{Binding PriorityText}" FontSize="11.5" FontWeight="Bold"/>
              </Border>
              <Border x:Name="rem" CornerRadius="5" Padding="7,3" Background="{StaticResource AccentSoft}" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="remIcon" Text="&#xEA8F;" FontFamily="{StaticResource Icons}" FontSize="11"
                             Foreground="{StaticResource AccentSoftText}" VerticalAlignment="Center" Margin="0,1,6,0"/>
                  <TextBlock x:Name="remText" Text="{Binding ReminderText}" Foreground="{StaticResource AccentSoftText}"
                             FontSize="12" FontWeight="SemiBold"/>
                  <TextBlock x:Name="remLate" Text="  · zamanı geldi" Foreground="{StaticResource Danger}" FontSize="12"
                             Visibility="Collapsed"/>
                </StackPanel>
              </Border>
              <TextBlock x:Name="meta" Text="{Binding CreatedText}" Foreground="{StaticResource TextFaint}" FontSize="12"
                         VerticalAlignment="Center"/>
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding HasNote}" Value="False">
          <Setter TargetName="note" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding HasReminder}" Value="False">
          <Setter TargetName="rem" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding HasLabel}" Value="False">
          <Setter TargetName="label" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding HasStages}" Value="False">
          <Setter TargetName="stageRow" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Priority}" Value="Yuksek">
          <Setter TargetName="stripe" Property="Background" Value="{StaticResource Warning}"/>
          <Setter TargetName="prio" Property="Visibility" Value="Visible"/>
          <Setter TargetName="prio" Property="Background" Value="{StaticResource WarningSoft}"/>
          <Setter TargetName="prioText" Property="Foreground" Value="{StaticResource Warning}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Priority}" Value="Acil">
          <Setter TargetName="stripe" Property="Background" Value="{StaticResource Danger}"/>
          <Setter TargetName="prio" Property="Visibility" Value="Visible"/>
          <Setter TargetName="prio" Property="Background" Value="{StaticResource DangerSoft}"/>
          <Setter TargetName="prioText" Property="Foreground" Value="{StaticResource Danger}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
          <Setter TargetName="rem" Property="Background" Value="{StaticResource DangerSoft}"/>
          <Setter TargetName="remText" Property="Foreground" Value="{StaticResource Danger}"/>
          <Setter TargetName="remIcon" Property="Foreground" Value="{StaticResource Danger}"/>
          <Setter TargetName="remLate" Property="Visibility" Value="Visible"/>
          <Setter TargetName="card" Property="BorderBrush" Value="#5A2A2E"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
          <Setter TargetName="title" Property="TextDecorations" Value="Strikethrough"/>
          <Setter TargetName="title" Property="Foreground" Value="{StaticResource TextMuted}"/>
          <Setter TargetName="meta" Property="Text" Value="{Binding CompletedText}"/>
          <Setter TargetName="rem" Property="Background" Value="{StaticResource Surface2}"/>
          <Setter TargetName="remText" Property="Foreground" Value="{StaticResource TextFaint}"/>
          <Setter TargetName="remIcon" Property="Foreground" Value="{StaticResource TextFaint}"/>
          <Setter TargetName="remLate" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="prio" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="stripe" Property="Background" Value="Transparent"/>
          <Setter TargetName="cardRoot" Property="Opacity" Value="0.75"/>
        </DataTrigger>
        <Trigger SourceName="cardRoot" Property="IsMouseOver" Value="True">
          <Setter TargetName="card" Property="Background" Value="{StaticResource SurfaceHover}"/>
        </Trigger>
        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Accent}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsSelectionMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
          <Setter TargetName="checkBtn" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="selBox" Property="Visibility" Value="Visible"/>
          <Setter TargetName="cardRoot" Property="Cursor" Value="Hand"/>
        </DataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding IsSelectionMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
          </MultiDataTrigger.Conditions>
          <Setter TargetName="selBox" Property="Background" Value="{StaticResource Accent}"/>
          <Setter TargetName="selBox" Property="BorderBrush" Value="{StaticResource Accent}"/>
          <Setter TargetName="selMark" Property="Visibility" Value="Visible"/>
          <Setter TargetName="card" Property="Background" Value="#1D2433"/>
        </MultiDataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- üst kısım -->
    <Grid Margin="22,18,22,0">
      <controls:EsnLogo x:Name="Logo" HorizontalAlignment="Left"/>
      <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AccentBtn}"
              Click="NewButton_Click" ToolTip="Yeni not (Ctrl+N)" Padding="16,8">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,1,8,0"/>
          <TextBlock Text="Yeni Not"/>
        </StackPanel>
      </Button>
    </Grid>

    <!-- hızlı ekleme -->
    <TextBox x:Name="QuickBox" Grid.Row="1" Margin="22,16,22,0" Padding="12,10"
             Tag="Hızlı not yaz ve Enter'a bas…   (hatırlatıcı için: Yeni Not)" KeyDown="QuickBox_KeyDown"/>

    <!-- sekmeler + arama -->
    <Grid Grid.Row="2" Margin="22,14,22,4">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <RadioButton x:Name="TabActive" Style="{StaticResource TabRadio}" GroupName="tabs" IsChecked="True"
                     Checked="Tab_Checked" Content="Aktif"/>
        <RadioButton x:Name="TabReminders" Style="{StaticResource TabRadio}" GroupName="tabs"
                     Checked="Tab_Checked" Content="Hatırlatmalı"/>
        <RadioButton x:Name="TabDone" Style="{StaticResource TabRadio}" GroupName="tabs"
                     Checked="Tab_Checked" Content="Tamamlanan"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="SelectModeButton" Style="{StaticResource GhostBtn}" Padding="10,6" Margin="0,0,8,0"
                Click="SelectMode_Click" ToolTip="Toplu seçim: birden fazla görevi seçip tamamla ya da sil (Ctrl+tık da olur)">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE762;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,1,7,0"/>
            <TextBlock x:Name="SelectModeText" Text="Seç"/>
          </StackPanel>
        </Button>
        <TextBox x:Name="SearchBox" Width="210" Padding="10,6" Tag="Ara…  (Ctrl+F)"
                 TextChanged="SearchBox_TextChanged"/>
      </StackPanel>
    </Grid>

    <!-- etiket filtresi. çipleri kod tarafında dolduruyoruz, hiç etiket yoksa gizli -->
    <WrapPanel x:Name="LabelBar" Grid.Row="3" Margin="22,8,22,0" Visibility="Collapsed"/>

    <!-- liste. Extended: ctrl/shift ile çoklu seçim ve ctrl+a çalışsın -->
    <ListBox x:Name="List" Grid.Row="4" Margin="22,8,10,0" Background="Transparent" BorderThickness="0"
             ItemTemplate="{StaticResource ItemTemplate}" HorizontalContentAlignment="Stretch"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel"
             SelectionMode="Extended" SelectionChanged="List_SelectionChanged"
             MouseDoubleClick="List_MouseDoubleClick" KeyDown="List_KeyDown">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="ContextMenu" Value="{StaticResource ItemMenu}"/>
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="Margin" Value="0,0,10,0"/>
          <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <ContentPresenter/>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
          <EventSetter Event="PreviewMouseRightButtonDown" Handler="Item_PreviewRightDown"/>
          <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Item_PreviewLeftDown"/>
        </Style>
      </ListBox.ItemContainerStyle>
    </ListBox>

    <StackPanel x:Name="EmptyState" Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Center"
                IsHitTestVisible="False" Margin="0,0,0,40">
      <TextBlock Text="&#xE73A;" FontFamily="{StaticResource Icons}" FontSize="38" Foreground="{StaticResource Border}"
                 HorizontalAlignment="Center"/>
      <TextBlock x:Name="EmptyTitle" FontSize="15" FontWeight="SemiBold"
                 Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,12,0,4"/>
      <TextBlock x:Name="EmptyHint" Foreground="{StaticResource TextFaint}" HorizontalAlignment="Center" FontSize="12.5"/>
    </StackPanel>

    <!-- toplu işlem çubuğu: seçim modunda listenin altında yüzüyor -->
    <Border x:Name="BulkBar" Grid.Row="4" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12"
            Background="{StaticResource Surface2}" BorderBrush="{StaticResource BorderHover}" BorderThickness="1"
            CornerRadius="12" Padding="8" Visibility="Collapsed">
      <Border.Effect>
        <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.55" Color="Black"/>
      </Border.Effect>
      <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="BulkCountText" VerticalAlignment="Center" Margin="10,0,16,0" FontWeight="SemiBold" MinWidth="110"/>
        <Button Style="{StaticResource GhostBtn}" Click="BulkSelectAll_Click" Margin="0,0,4,0" ToolTip="Bu sekmede görünen tüm görevleri seç (Ctrl+A)">
          <TextBlock Text="Tümünü seç"/>
        </Button>
        <Button x:Name="BulkCompleteButton" Click="BulkComplete_Click" Margin="0,0,6,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{StaticResource Success}"
                       VerticalAlignment="Center" Margin="0,1,7,0"/>
            <TextBlock x:Name="BulkCompleteText" Text="Tamamla"/>
          </StackPanel>
        </Button>
        <Button x:Name="BulkDeleteButton" Style="{StaticResource DangerBtn}" Click="BulkDelete_Click" Margin="0,0,6,0"
                ToolTip="Seçilenleri sil (Del)">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center" Margin="0,1,7,0"/>
            <TextBlock Text="Sil"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource GhostBtn}" Click="BulkCancel_Click" Padding="10,7" ToolTip="Seçimden çık (Esc)">
          <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="11"/>
        </Button>
      </StackPanel>
    </Border>

    <!-- silme sonrası "geri al" bildirimi -->
    <Border x:Name="UndoBar" Grid.Row="4" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12"
            Background="{StaticResource Surface2}" BorderBrush="{StaticResource BorderHover}" BorderThickness="1"
            CornerRadius="12" Padding="16,8,8,8" Visibility="Collapsed">
      <Border.Effect>
        <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.55" Color="Black"/>
      </Border.Effect>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{StaticResource TextMuted}"
                   VerticalAlignment="Center" Margin="0,1,10,0"/>
        <TextBlock x:Name="UndoText" VerticalAlignment="Center" Margin="0,0,18,0"/>
        <Button Style="{StaticResource AccentBtn}" Click="Undo_Click" Padding="14,6" Content="Geri al"/>
        <Button Style="{StaticResource GhostBtn}" Click="UndoClose_Click" Padding="10,7" Margin="4,0,0,0" ToolTip="Kapat">
          <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="11"/>
        </Button>
      </StackPanel>
    </Border>

    <!-- alt bilgi çubuğu -->
    <Border Grid.Row="5" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
            BorderThickness="0,1,0,0" Padding="22,9" Margin="0,8,0,0">
      <Grid>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Warning}"
                     VerticalAlignment="Center" Margin="0,1,8,0" FontSize="12"/>
          <TextBlock x:Name="NextText" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextFaint}" FontSize="12"
                   Text="Sağ tık: seçenekler  ·  Ctrl+tık: çoklu seçim  ·  Ctrl+E: aşamalar"/>
      </Grid>
    </Border>
  </Grid>
</Window>
