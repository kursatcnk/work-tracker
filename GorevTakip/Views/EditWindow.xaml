<Window x:Class="GorevTakip.Views.EditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Not" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" UseLayoutRounding="True" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown"
        Icon="pack://application:,,,/GorevTakip;component/Assets/app.ico">
  <StackPanel Margin="22,18,22,20">
    <TextBlock x:Name="HeaderText" Text="Yeni not" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,16"/>

    <TextBlock Text="Başlık" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,0,6"/>
    <TextBox x:Name="TitleBox" Tag="Örn: Bakiye bilgisi istenecek"/>

    <!-- etiket solda, öncelik sağda -->
    <Grid Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Müşteri / etiket" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,0,6"/>
        <TextBox x:Name="LabelBox" Tag="Örn: KM Kümsan (isteğe bağlı)" TextChanged="LabelBox_TextChanged"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="Öncelik" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,0,6"/>
        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                CornerRadius="9" Padding="3" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="PrioNormal" Style="{StaticResource TabRadio}" GroupName="prio" IsChecked="True" Margin="0">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Fill="{StaticResource TextFaint}" Margin="0,1,7,0" VerticalAlignment="Center"/>
                <TextBlock Text="Normal"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="PrioHigh" Style="{StaticResource TabRadio}" GroupName="prio" Margin="0">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Fill="{StaticResource Warning}" Margin="0,1,7,0" VerticalAlignment="Center"/>
                <TextBlock Text="Yüksek"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="PrioUrgent" Style="{StaticResource TabRadio}" GroupName="prio" Margin="0">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Fill="{StaticResource Danger}" Margin="0,1,7,0" VerticalAlignment="Center"/>
                <TextBlock Text="Acil"/>
              </StackPanel>
            </RadioButton>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <!-- daha önce kullanılan etiketler, tıklayınca kutuya yazılıyor -->
    <WrapPanel x:Name="LabelSuggestions" Margin="0,8,0,0"/>

    <TextBlock Text="Not" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,8,0,6"/>
    <TextBox x:Name="NoteBox" Height="96" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
             VerticalScrollBarVisibility="Auto"
             Tag="Örn: Bakiyenin 15 Ekim'de kapatılacağını söyledi. O gün tekrar yazıp kontrol et."/>

    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1"
            CornerRadius="10" Padding="14" Margin="0,16,0,0">
      <StackPanel>
        <CheckBox x:Name="ReminderCheck" Content="Hatırlatıcı kur (zamanı gelince ekrana uyarı çıkar)"
                  Checked="Reminder_Changed" Unchecked="Reminder_Changed"/>

        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="110"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Tarih" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,0,6"/>
            <DatePicker x:Name="DateBox" SelectedDateChanged="DateBox_SelectedDateChanged"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Saat" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,0,6"/>
            <TextBox x:Name="TimeBox" Tag="SS:dd" TextChanged="TimeBox_TextChanged" MaxLength="5"
                     HorizontalContentAlignment="Center" FontSize="14"/>
          </StackPanel>
        </Grid>

        <WrapPanel Margin="0,12,0,0">
          <Button Style="{StaticResource ChipBtn}" Tag="30m" Click="Quick_Click" Content="+30 dk"/>
          <Button Style="{StaticResource ChipBtn}" Tag="2h" Click="Quick_Click" Content="+2 saat"/>
          <Button Style="{StaticResource ChipBtn}" Tag="today17" Click="Quick_Click" Content="Bugün 17:00"/>
          <Button Style="{StaticResource ChipBtn}" Tag="tomorrow9" Click="Quick_Click" Content="Yarın 09:00"/>
          <Button Style="{StaticResource ChipBtn}" Tag="week" Click="Quick_Click" Content="1 hafta sonra"/>
        </WrapPanel>

        <TextBlock x:Name="Preview" FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" FontSize="12.5" Margin="0,12,0,0"
               TextWrapping="Wrap" Visibility="Collapsed"/>

    <Grid Margin="0,18,0,0">
      <TextBlock Text="Ctrl+Enter: kaydet" Foreground="{StaticResource TextFaint}" FontSize="12" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="İptal" IsCancel="True" Margin="0,0,8,0" MinWidth="90"/>
        <Button Content="Kaydet" Style="{StaticResource AccentBtn}" IsDefault="True" Click="Save_Click" MinWidth="110"/>
      </StackPanel>
    </Grid>
  </StackPanel>
</Window>
