<Window x:Class="GorevTakip.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ESN Görev Takip" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" UseLayoutRounding="True" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="22,18,22,20">
    <TextBlock x:Name="HeaderText" FontSize="17" FontWeight="SemiBold"/>
    <TextBlock x:Name="MessageText" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" FontSize="13"
               Margin="0,10,0,0" LineHeight="19"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button x:Name="NoButton" IsCancel="True" Margin="0,0,8,0" MinWidth="90" Click="No_Click"/>
      <Button x:Name="YesButton" Style="{StaticResource AccentBtn}" IsDefault="True" MinWidth="90" Click="Yes_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
